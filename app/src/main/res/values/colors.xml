<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Reading surface: warm cream, not sterile white or bluish gray. -->
    <color name="paper">#FFFAF8F5</color>
    <color name="surface">#FFFFFFFF</color>
    <color name="surface_variant">#FFF5F0E8</color>

    <!-- Type: warm charcoal for body, warm stone for supporting text. -->
    <color name="ink">#FF201E1D</color>
    <color name="ink_muted">#FF6E6862</color>

    <!-- Single quiet accent: Warm Amber / Honey (Read-it-later style). 5.1:1 on cream. -->
    <color name="accent_warm">#FFB45309</color>
    <color name="on_accent_warm">#FFFFFFFF</color>
    <color name="accent_container">#FFFDF1DC</color>
    <color name="on_accent_container">#FF451A03</color>

    <!-- Semantic aliases mapped to warm accent for theme compatibility -->
    <color name="indigo">@color/accent_warm</color>
    <color name="on_indigo">@color/on_accent_warm</color>
    <color name="indigo_container">@color/accent_container</color>
    <color name="on_indigo_container">@color/on_accent_container</color>

    <!-- Subtle warm hairline and card strokes. -->
    <color name="hairline">#FFE6E0D6</color>

    <!-- Semantic status colors (gentle, warm, no neon slop). -->
    <color name="status_completed">#FF2E6930</color>
    <color name="status_completed_container">#FFEBF5EC</color>
    <color name="status_pending">#FF92400E</color>
    <color name="status_pending_container">#FFFDF1DC</color>
    <color name="status_error">#FFBA1A1A</color>
    <color name="status_error_container">#FFFFDAD6</color>
</resources>
